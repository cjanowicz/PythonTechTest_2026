global:
    scrape_interval: 15s

scrape_configs:
    - job_name: node
        static_configs:
            {% for host in groups['monitoring_servers'] %}
            - targets: ["{{ hostvars[host].ansible_host | default(host) }}:9100"]
            labels:
                instance: "{{ host }}"
            {% endfor %}
    
    - job_name: docker
        static_configs:
            {% for host in groups['monitoring_servers'] %}
            - targets: ["{{ hostvars[host].ansible_host | default(host) }}:9323"]
            labels:
                instance: "{{ host }}"
            {% endfor %}
